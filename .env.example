SECRET_KEY=changeme-generate-a-new-django-secret-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

DB_NAME=inventario_ia
DB_USER=diego
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Asistente conversacional (RAG): proveedor del modelo de lenguaje.
# - ollama: local, los datos de la microempresa no salen del equipo.
#   LLM_URL es la URL base de la API de Ollama, sin /api/chat.
# - anthropic: Claude vía la API de Anthropic (servicio externo; el
#   contexto se anonimiza antes de enviarse). Requiere ANTHROPIC_API_KEY.
#   Ejemplo: LLM_PROVEEDOR=anthropic y LLM_MODELO=claude-haiku-4-5
LLM_PROVEEDOR=ollama
LLM_MODELO=qwen2.5:7b
LLM_URL=http://localhost:11434
# Solo para LLM_PROVEEDOR=anthropic. Nunca la subas al repositorio.
ANTHROPIC_API_KEY=
# Origen de los datos con los que el asistente indexa y responde
# (real|prueba). Tras cambiarlo, correr "indexar_conocimiento".
ASISTENTE_ORIGEN=real

# Opcional: si se define, el anonimizador la redacta antes de enviar
# cualquier dato a la API del modelo de lenguaje.
EMPRESA_RAZON_SOCIAL=

# Umbrales de severidad de las diferencias de inventario, como fracción de
# la diferencia sobre el stock de sistema (1.0 = 100%). Alta desde
# ANOMALIA_UMBRAL_ALTA (inclusive), media desde ANOMALIA_UMBRAL_MEDIA, baja
# por debajo.
ANOMALIA_UMBRAL_ALTA=1.0
ANOMALIA_UMBRAL_MEDIA=0.40

# Tolerancia relativa del acierto del pronóstico (evaluar_predicciones): un
# día cuenta como acierto si |real - pronóstico| / max(real, 1) <= este valor.
# Criterio de negocio: 0.20 es la misma regla del 20% que el sistema ya usa
# como diferencia tolerable entre stock de sistema y stock físico (detección
# de anomalías). Se fija ANTES de evaluar y no se cambia según el resultado.
# No hay tolerancia en unidades: ver "Exactitud del pronóstico" en el README.
PRONOSTICO_TOLERANCIA_RELATIVA=0.20
